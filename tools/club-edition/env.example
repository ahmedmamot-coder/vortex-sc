# Copy to .env.local (or set these in Vercel → Settings → Environment Variables).

# --- Required: your Supabase project (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # secret — server only

# Your site's address, e.g. https://myclub.com
APP_URL=

# Comma-separated sign-in emails allowed to set staff passwords and delete accounts.
# Leave empty to use the staff table's full-access roles instead.
VX_ADMIN_EMAILS=

# --- Optional features (leave empty to switch them off) ---
ANTHROPIC_API_KEY=                  # AI plan review / assistant
CRON_SECRET=
BACKUP_SECRET=
BIRTHDAY_CRON_SECRET=

# Web push (npx web-push generate-vapid-keys); put the public key in public/assets/club-config.js too
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# iOS push (only if you build the iOS app)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=
APNS_ENV=

# Wearables
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=
WHOOP_SYNC_SECRET=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=

# Odoo accounting
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=

# Claude connector (MCP) token
VX_MCP_TOKEN=
